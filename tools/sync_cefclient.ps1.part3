Write-Host 'PersonalCEF cefclient framework prepared successfully.' -ForegroundColor Green
Write-Host "CEF SDK (untouched): $CefRoot"
Write-Host "Generated cefclient:  $cefClientDir"
Write-Host 'Architecture: native CEF Chrome-style window + PersonalChromeHandler; no custom tab UI.'
