    // Do not let cefclient wrap popup/new-tab requests in RootWindow. Let the
    // native Chrome runtime own tab/window disposition exactly like Chromium.
    command_line->AppendSwitch("use-default-popup");

    // Append Chromium command line parameters if touch events are enabled
'@
Patch-Once $path 'PERSONALCEF_R8_BROWSER_COMMAND_LINE' $search $replace


$search = @'
    // Default client handler for unmanaged browser windows. Used with
    // Chrome style only.
    LOG(INFO) << "Creating a chrome browser with the default client";
    return new DefaultClientHandler();
'@
$replace = @'
    // PERSONALCEF_R11_DEFAULT_CLIENT
    // Every native Chrome-created tab/window uses the same PersonalCEF browser
    // services while the actual UI remains 100% CEF/Chromium-owned.
    LOG(INFO) << "Creating a chrome browser with PersonalCEF services";
    return personal::PersonalChromeHandler::GetShared();
'@
Patch-Once $path 'PERSONALCEF_R11_DEFAULT_CLIENT' $search $replace

# ---------------------------------------------------------------------------
# 4) Extend the official ClientHandler resource callbacks. Popup, focus,
#    renderer recovery, message routing and browser lifetime remain official.
# ---------------------------------------------------------------------------

$path = Join-Path $cefClientDir 'browser\client_handler.h'

$search = @'
  // CefResourceRequestHandler methods
  void OnProtocolExecution(CefRefPtr<CefBrowser> browser,
'@
$replace = @'
